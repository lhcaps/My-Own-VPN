# =============================================================================
#  WireGuard secrets & configs - NEVER commit these.
# =============================================================================
*.key
*.keypair
*.priv
*.private
*.conf
wg0.conf
wg*.conf

# Client / revoked archives generated by the scripts
wireguard-secrets/
secrets/

# Generated client configs (kept under /etc/wireguard/clients on the server)
clients/
clients/revoked/

# wg0.conf backups produced by add-client.sh / revoke-client.sh
backups/
*.bak

# Examples folder is intentionally empty in this repo; placeholder rule kept
# so that real-looking keys dropped in by accident won't be committed.
examples/wireguard-clients/*.conf
examples/wireguard-clients/*.key
examples/wireguard-clients/*.pub

# Provisioning & one-shot creds (Oracle, SSH, tokens)
.env
.env.*
*.envrc
*.pem
*.crt
*.csr
oci-api-key*
api-key*.pem
*.oci

# OS / IDE noise (kept here so contributors don't have to redo it)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Terraform/iptables captures sometimes contain hostnames/IPs we don't want
*.tfstate
*.tfstate.backup
iptables-save.txt
